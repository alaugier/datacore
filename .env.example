# Copier ce fichier en .env (jamais versionné) et ajuster si besoin.
# Utilisé par infra/docker/docker-compose.yml et scripts/init_staging_db.sh

POSTGRES_DB=datacore_staging
POSTGRES_USER=datacore
POSTGRES_PASSWORD=datacore
POSTGRES_PORT=5432

# Entrepôt OMEGA BI (C13-C17) : base distincte, même instance Postgres
# que la base de staging (sobriété RGESN — pas de second conteneur).
OMEGA_BI_DB=datacore_omega_bi

API_MOCK_PORT=5050
API_KEY=datacore-training-2026

OMEGA_DATA_API_PORT=8000

# Data lake OMEGA LAKE (C18-C21) : MinIO, stockage objet compatible S3,
# meme instance locale que le reste (sobriete RGESN). Bucket unique
# "omega-lake", cree automatiquement par le service minio-init.
MINIO_ROOT_USER=datacore
MINIO_ROOT_PASSWORD=datacore_lake
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OMEGA_LAKE_BUCKET=omega-lake

# Droits d'accès par groupe (C21) : utilisateur MinIO en lecture seule
# (GetObject/ListBucket uniquement, jamais d'écriture) pour les
# consommateurs BI -- même principe que bi_reader pour l'entrepôt (C14).
LAKE_READER_USER=lake_reader
LAKE_READER_PASSWORD=datacore_lake_reader
