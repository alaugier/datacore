__pycache__/
*.pyc
.venv/
.env
data/raw/*
!data/raw/README.md
data/interim/
*.egg-info/
backups/

# Rapport LaTeX (M5) -- fichiers de compilation intermédiaires, pas le
# document source ni le PDF final (rapport.pdf est committé).
docs/latex/*.aux
docs/latex/*.log
docs/latex/*.out
docs/latex/*.toc
docs/latex/chapitres/*.aux
docs/latex/annexes/*.aux

# Supports de formation Simplon (droits de redistribution non
# confirmés) -- jamais versionnés, gardés en local uniquement.
# (crochets échappés : [ ] sont des métacaractères gitignore)
docs/reference/\[DE\] Notes sur la certification.pdf
